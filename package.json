{
  "name": "bdd-automation-scaffold",
  "version": "0.1.0",
  "description": "Greenfield BDD test automation scaffold \u2014 Playwright + Cucumber.js + TypeScript. Generic demo domain.",
  "scripts": {
    "test": "cucumber-js",
    "test:dry": "cucumber-js --dry-run",
    "catalog": "cucumber-js --dry-run --format message:cucumber-messages.ndjson && ts-node scripts/extract-steps.ts cucumber-messages.ndjson && ts-node scripts/render-markdown.ts",
    "report": "echo \"HTML report is configured in cucumber.js (html formatter)\"",
    "validate:steps": "ts-node --project tsconfig.json scripts/validate-steps.ts",
    "catalog:watch": "ts-node scripts/watch-catalog.ts",
    "jira:sync": "ts-node scripts/jira-sync.ts",
    "jira:sync:dry": "ts-node scripts/jira-sync.ts --dry-run",
    "jira:probe": "ts-node scripts/jira-fetch.ts --probe",
    "jira:fetch": "ts-node scripts/jira-fetch.ts",
    "confluence:discover": "ts-node scripts/confluence-fetch.ts --discover",
    "confluence:probe": "ts-node scripts/confluence-fetch.ts --probe",
    "confluence:fetch": "ts-node scripts/confluence-fetch.ts",
    "scout": "ts-node scripts/scout.ts",
    "record": "ts-node scripts/record.ts",
    "session": "ts-node scripts/session.ts",
    "rules:sync": "ts-node scripts/sync-rules.ts",
    "rules:check": "ts-node scripts/sync-rules.ts --check",
    "check:extract": "ts-node scripts/lib/atlassian.check.ts",
    "check:normalize": "ts-node scripts/lib/normalize.check.ts",
    "check:stability": "ts-node scripts/lib/stability.check.ts",
    "check:gold": "ts-node scripts/lib/gold.check.ts",
    "check:storage": "ts-node scripts/lib/markdown-storage.check.ts",
    "check:all": "npm run check:extract && npm run check:normalize && npm run check:stability && npm run check:gold && npm run check:storage && npm run check:templates && npm run check:generate && npm run check:benchmark && npm run check:labelling && npm run check:inventory && npm run check:args && npm run check:eol",
    "analyze:corpus": "ts-node scripts/analyze-corpus.ts",
    "catalog:sync": "ts-node scripts/catalog-sync.ts",
    "confluence:publish": "ts-node scripts/confluence-publish.ts",
    "prepare": "husky",
    "check:templates": "ts-node scripts/lib/render-template.check.ts",
    "generate": "ts-node scripts/generate.ts",
    "check:generate": "ts-node scripts/lib/generate-core.check.ts",
    "benchmark": "ts-node scripts/benchmark.ts",
    "check:benchmark": "ts-node scripts/lib/benchmark.check.ts",
    "arena": "ts-node scripts/benchmark-arena.ts",
    "targets": "ts-node scripts/targets.ts",
    "scout:pausa": "ts-node scripts/scout.ts --pause",
    "diagnosi": "ts-node scripts/diagnosi.ts",
    "referto": "ts-node scripts/referto.ts",
    "check:labelling": "ts-node scripts/lib/labelling.check.ts",
    "check:inventory": "ts-node scripts/lib/inventory.check.ts",
    "test:bersaglio": "ts-node scripts/test-bersaglio.ts",
    "check:args": "ts-node scripts/lib/args.check.ts",
    "check:eol": "ts-node scripts/lib/eol.check.ts"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "typescript",
    "e2e"
  ],
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "husky": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
