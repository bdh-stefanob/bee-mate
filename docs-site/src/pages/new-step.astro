---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import StepAuthorForm from '../components/StepAuthorForm';
---

<StarlightPage
  frontmatter={{
    title: 'Nuovo Step',
    description: 'Crea una nuova step definition con documentazione completa.',
  }}
>
  <p>
    Compila il form per generare il codice TypeScript di uno step con JSDoc
    (<code>@intent</code>, <code>@param</code>, <code>@pre</code>, <code>@post</code>).
    Una volta copiato, incollalo nel file di step del dominio corrispondente
    e lancia <code>npm run catalog</code> per aggiornare il catalogo.
  </p>

  <StepAuthorForm client:only="react" />
</StarlightPage>
