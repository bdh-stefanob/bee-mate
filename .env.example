# Copia questo file in .env e compila i valori.
# .env è gitignored — NON committare mai credenziali reali.

# URL della tua istanza Jira (senza slash finale)
JIRA_URL=https://company.atlassian.net

# Account Jira (email usata per il login)
JIRA_EMAIL=nome@company.com

# Personal Access Token — genera qui:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=your_api_token_here
